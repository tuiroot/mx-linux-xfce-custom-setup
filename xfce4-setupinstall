This script will...
- install apps from distro repo
- install apps from external repos like librewolf or protonvpn
- install bash admin scripts as systemwide command
- install bash user scripts as systemwide command
- users right management
- anachron for root
- cronjobs for user
- autostarts for user
- Preconfigured Desktop for new users /etc/skel
- init appmaker MakeMyApp
########################################################################

EOF

read -rp "Press Enter to continue or strg + c to abort"

#install_repo
#install_extrepo
#install_admin_scripts &
#install_user_scripts &
#install_config &
#install_anachron &
#install_user_rights &
#install_chron &
#install_autostart &
install_launcher "/etc/skel &

